# NORPIA — production environment template for the VPS deployment.
# Copy to .env.production on the server and fill in real values. Never commit it.

# --- Application ---
NODE_ENV=production
APP_NAME=NORPIA
LOG_LEVEL=info
PORT=3000
HOST=0.0.0.0

# Public origin the app is reached at. No domain yet -> use http://<VPS_IP>.
APP_ORIGIN=http://203.0.113.10

# --- Frontend (public, baked into the client bundle at build time) ---
VITE_API_BASE_URL=/api/v1
VITE_APP_ENV=production

# --- Database (server-only; host `db` is the compose service) ---
POSTGRES_USER=norpia
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_DB=norpia
DATABASE_URL=postgres://norpia:replace-with-a-long-random-secret@db:5432/norpia
DATABASE_POOL_MAX=20

# --- Storage (server-only, Phase 2) ---
STORAGE_PROVIDER=local
STORAGE_BUCKET=norpia
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- AI providers (server-only, Week 4 — leave empty for now) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Integrations (server-only, Phase 2) ---
N8N_API_KEY=
MCP_SERVER_URL=
