# NORPIA — environment template. Copy to .env and fill in locally.
# Placeholders only: never commit real secrets.

# --- Application ---
NODE_ENV=development
APP_NAME=NORPIA
LOG_LEVEL=debug

# --- Frontend (public, safe to expose) ---
VITE_API_BASE_URL=/api/v1
VITE_APP_ENV=development

# --- Database (server-only) ---
POSTGRES_USER=norpia
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=norpia
DATABASE_URL=postgres://norpia:change-me-locally@localhost:5432/norpia
DATABASE_POOL_MAX=10

# --- Storage (server-only, Phase 2) ---
STORAGE_PROVIDER=local
STORAGE_BUCKET=norpia-dev
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- AI providers (server-only, Week 4 — placeholders) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Integrations (server-only, Phase 2 — placeholders) ---
N8N_API_KEY=
MCP_SERVER_URL=

# --- AI model configuration (server-only, Week 4) ---
AI_MODEL=gpt-4o-mini
AI_PROMPT_VERSION=v1
AI_TEMPERATURE=0.4
# Cost control (canonical names; AI_* legacy names still honoured)
MAX_OUTPUT_TOKENS=1024
MAX_CONTEXT_MESSAGES=20
MAX_CONTEXT_CHARACTERS=24000
MAX_MESSAGE_LENGTH=8000
# Context management (server-only, Month 2 Week 1)
# Falls back to a per-model limit when unset.
MAX_INPUT_TOKENS=
# Conversation summarisation (Month 2 Week 1) — server-only
SUMMARY_ENABLED=true
SUMMARY_TRIGGER_MESSAGES=24
SUMMARY_KEEP_RECENT_MESSAGES=10
SUMMARY_MAX_SOURCE_CHARACTERS=24000
SUMMARY_MAX_OUTPUT_TOKENS=400
# Optional cheaper model for summaries; defaults to AI_MODEL
SUMMARY_MODEL=
