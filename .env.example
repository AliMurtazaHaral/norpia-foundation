# NORPIA — environment template. Copy to .env and fill in locally.
# Placeholders only: never commit real secrets.

# --- Application ---
NODE_ENV=development
APP_NAME=NORPIA
LOG_LEVEL=debug

# --- Frontend (public, safe to expose) ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_ENV=development

# --- Database (server-only) ---
POSTGRES_USER=norpia
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=norpia
DATABASE_URL=postgres://norpia:change-me-locally@localhost:5432/norpia
DATABASE_POOL_MAX=10

# --- Storage (server-only, Phase 2) ---
STORAGE_PROVIDER=local
STORAGE_BUCKET=norpia-dev
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- AI providers (server-only, Week 4 — placeholders) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Integrations (server-only, Phase 2 — placeholders) ---
N8N_API_KEY=
MCP_SERVER_URL=
